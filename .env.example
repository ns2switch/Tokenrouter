# Upstream NIM (default provider — in-memory only, never stored in DynamoDB)
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_API_KEY=replace-with-real-key

# Additional providers are managed via admin API (POST /admin/providers):
# curl -X POST http://localhost:8080/admin/providers \
#   -H "Authorization: Bearer $ADMIN_BEARER_TOKEN" \
#   -H "Content-Type: application/json" \
#   -d '{"id":"nim-gpu","name":"NIM-GPU","base_url":"https://another.example.com","api_key":"sk-..."}'
#
# Then assign models to the provider via pricing (POST /admin/pricing):
# curl -X POST http://localhost:8080/admin/pricing \
#   -H "Authorization: Bearer $ADMIN_BEARER_TOKEN" \
#   -H "Content-Type: application/json" \
#   -d '{"model_name":"llama-3","provider_id":"nim-gpu","provider_cost_input_per_1m":1.0,...}'

# DynamoDB table names
DDB_API_KEYS_TABLE=api_keys
DDB_PROVIDERS_TABLE=providers
DDB_PRICING_TABLE=pricing_config
DDB_TRANSACTIONS_TABLE=transactions
DDB_TRANSACTIONS_TIMELINE_TABLE=transactions_timeline
DDB_IDEMPOTENCY_TABLE=idempotency_keys
DDB_METRICS_TABLE=metrics_global
# DDB_DEAD_LETTER_TABLE=dead_letter

API_KEY_HASH_SECRET=REPLACE_ME
IDEMPOTENCY_TTL_SECONDS=86400
ADMIN_BEARER_TOKEN=REPLACE_ME
# Optional CSV for token rotation: ADMIN_BEARER_TOKENS=token_a,token_b
ADMIN_BEARER_TOKENS=
# Comma-separated CIDR allowlist for admin routes: ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16
ADMIN_IP_ALLOWLIST=
PROVIDER_NAME_PREFIX=TokenRouter
PROVIDER_QUANTIZATION=fp16
PROVIDER_CONTEXT_LENGTH=128000
PROVIDER_MAX_OUTPUT_LENGTH=8192
PROVIDER_DATACENTER_COUNTRY=US
MAX_INFLIGHT_REQUESTS=200
# Maximum concurrent requests per API key (default 10)
MAX_INFLIGHT_PER_KEY=10
# Maximum output tokens cap (default 16384)
MAX_OUTPUT_TOKENS=16384
# Number of shards for transactions_timeline (default 1 = single partition)
TIMELINE_SHARD_COUNT=1
# Interval in seconds for flushing runtime metrics to DynamoDB
METRICS_FLUSH_INTERVAL_SECONDS=300

# HTTP client timeout for upstream requests (default 300)
UPSTREAM_TIMEOUT_SECONDS=300
# Maximum duration of a streaming response (default 600)
MAX_STREAMING_DURATION_SECONDS=600

# Response cache (defaults: 3600s TTL, 1000 entries, 64KB max per entry)
REQUEST_CACHE_TTL_SECONDS=3600
REQUEST_CACHE_MAX_ENTRIES=1000
REQUEST_CACHE_MAX_RESPONSE_BYTES=65536

# Admin rate limiting (defaults: 5 failures / 60s window)
ADMIN_RATE_LIMIT_MAX_FAILURES=5
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60

# Runtime
# RUN_MODE=lambda -> AWS Lambda
# RUN_MODE=server -> local HTTP server
RUN_MODE=server
LISTEN_ADDR=0.0.0.0:8080

# Optional for local DynamoDB / LocalStack
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
